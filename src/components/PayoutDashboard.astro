---
import gradesData from "../data/grades.json";
import { calculatePayout } from "../utils/payout";

const { totalPayout } = calculatePayout(gradesData.classes);
const currency = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
});
const formattedTotal = currency.format(totalPayout);
---

<section class="payout-screen" aria-labelledby="payout-heading">
    <h1 id="payout-heading" class="sr-only">Gavin's grade allowance</h1>
    <div class="total" aria-label={`${formattedTotal} total earned`}>{formattedTotal}</div>
</section>

<style>
    .payout-screen { display: grid; place-items: center; width: 100%; min-height: 100svh; }
    .total { color: #f2f5ef; font: 400 clamp(8rem, 34vw, 32rem)/.78 "DM Serif Display", Georgia, serif; letter-spacing: -.085em; text-shadow: 0 0 70px rgba(97, 212, 154, .1); animation: arrive .8s cubic-bezier(.2, .8, .2, 1) both; }
    @keyframes arrive { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: scale(1); } }
    @media (prefers-reduced-motion: reduce) { .total { animation: none; } }
</style>
