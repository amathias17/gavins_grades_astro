---
import gradesData from "../data/grades.json";
import { calculatePayout, getPayoutDisplayParts, formatPayoutAmount } from "../utils/payout";

const { totalPayout } = calculatePayout(gradesData.classes);
const formattedAmount = formatPayoutAmount(totalPayout);
const amountParts = getPayoutDisplayParts(totalPayout);
const reelDigits = Array.from({ length: 70 }, (_, index) => index % 10);
---

<section class="payout-screen" aria-labelledby="payout-heading">
    <h1 id="payout-heading" class="sr-only">Gavin's grade allowance</h1>
    <div class="payout-stack">
        <div class="total" data-final={formattedAmount} data-digit-count={amountParts.filter((part) => /\d/.test(part)).length} role="img" aria-label={`${formattedAmount} dollars total earned`}>
            {amountParts.map((part) => part === "," ? (
                <span class="amount-separator" aria-hidden="true">,</span>
            ) : (
                <span class="digit-window" aria-hidden="true">
                    <span class="digit-reel" data-digit-reel data-final-digit={part} style={`transform: translateY(-${50 + Number(part)}em)`}>
                        {reelDigits.map((digit) => <span class="digit">{digit}</span>)}
                    </span>
                </span>
            ))}
        </div>
        <div class="money-label" data-money-label data-text="DOLLARS" aria-hidden="true">DOLLARS</div>
    </div>
</section>

<script>
    const total = document.querySelector<HTMLElement>(".total");
    const label = document.querySelector<HTMLElement>("[data-money-label]");
    const reels = Array.from(document.querySelectorAll<HTMLElement>("[data-digit-reel]"));
    const words = ["DOLLARS", "BUCKS", "BUCKAROOS", "IN DOUGH", "DOLLARS CASH", "SLICES OF BACON"];
    const effects = ["glitch-slice", "glitch-flicker", "glitch-scan", "glitch-burst"];
    const effectClasses = ["glitch-slice", "glitch-flicker", "glitch-scan", "glitch-burst"];

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let wordTimer: number | undefined;
    let landingTimer: number | undefined;

    const startWordRotation = () => {
        if (!label || reduceMotion || wordTimer !== undefined) return;
        let wordIndex = 0;
        let effectIndex = 0;
        const randomIndexExcept = (length: number, current: number) => {
            let next = current;
            while (length > 1 && next === current) {
                next = Math.floor(Math.random() * length);
            }
            return next;
        };

        wordTimer = window.setInterval(() => {
            wordIndex = randomIndexExcept(words.length, wordIndex);
            effectIndex = randomIndexExcept(effects.length, effectIndex);
            const nextWord = words[wordIndex];
            label.textContent = nextWord;
            label.dataset.text = nextWord;
            label.classList.remove("is-glitching", ...effectClasses);
            void label.offsetWidth;
            label.classList.add("is-glitching", effects[effectIndex]);
            window.setTimeout(() => label.classList.remove("is-glitching", ...effectClasses), 560);
        }, 6000);

    };

    if (total && label && reduceMotion) {
        reels.forEach((reel) => {
            const finalDigit = Number(reel.dataset.finalDigit ?? "0");
            reel.style.transform = `translateY(-${50 + finalDigit}em)`;
        });
        label.classList.add("is-ready");
    } else if (total && label && reels.length > 0) {
        const finalAmount = total.dataset.final ?? "0";
        const finalDigits = [...finalAmount].filter((character) => /\d/.test(character));

        reels.forEach((reel, index) => {
            const finalDigit = Number(reel.dataset.finalDigit ?? finalDigits[index] ?? "0");
            const startIndex = Math.floor(Math.random() * 10);
            const landingIndex = 50 + finalDigit;
            reel.style.transform = `translateY(-${startIndex}em)`;
            reel.style.setProperty("--reel-delay", `${index * 35}ms`);
            reel.style.setProperty("--landing-index", String(landingIndex));
        });

        total.classList.add("is-spinning");

        requestAnimationFrame(() => {
            reels.forEach((reel) => {
                reel.style.transform = `translateY(calc(var(--landing-index) * -1em))`;
            });
        });

        landingTimer = window.setTimeout(() => {
            total.classList.remove("is-spinning");
            label.classList.add("is-ready");
            startWordRotation();
            landingTimer = undefined;
        }, 2200 + (reels.length - 1) * 35);
    }

    document.addEventListener("astro:before-swap", () => {
        if (wordTimer !== undefined) window.clearInterval(wordTimer);
        if (landingTimer !== undefined) window.clearTimeout(landingTimer);
    }, { once: true });
</script>

<style>
    .payout-screen { display: grid; place-items: center; width: 100%; min-height: 100svh; }
    .payout-stack { display: grid; justify-items: center; }
    .total { display: flex; align-items: center; justify-content: center; color: #f2f5ef; font: 700 clamp(8rem, 34vw, 32rem)/1 "Orbitron", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: .03em; text-shadow: 0 0 70px rgba(97, 212, 154, .1); }
    .digit-window { display: block; width: .7em; height: 1em; overflow: hidden; }
    .digit-reel { display: flex; flex-direction: column; align-items: center; transform: translateY(0); }
    .digit { display: grid; width: 100%; height: 1em; place-items: center; }
    .amount-separator { width: .35em; text-align: center; }
    .total.is-spinning { color: #c8d4cc; text-shadow: 3px 0 #ff4fd8, -3px 0 #61d49a; }
    .total.is-spinning .digit-reel { filter: blur(.035em); transition: transform 2.1s cubic-bezier(.18, .86, .22, 1); transition-delay: var(--reel-delay); }
    .money-label { position: relative; margin-top: 2rem; color: #61d49a; font: 700 clamp(1.1rem, 3.5vw, 1.65rem)/1 "Orbitron", sans-serif; letter-spacing: .28em; text-align: center; opacity: 0; transform: translateY(-.5rem); }
    .money-label.is-ready { opacity: 1; transform: translateY(0); transition: opacity .35s ease, transform .35s ease; }
    .money-label.is-glitching { animation: label-glitch .56s steps(2, end) both; }
    .money-label.is-glitching::before, .money-label.is-glitching::after { position: absolute; inset: 0; pointer-events: none; content: attr(data-text); }
    .money-label.is-glitching::before { color: #f2f5ef; clip-path: inset(0 0 52% 0); transform: translateX(-.08em); }
    .money-label.is-glitching::after { color: #ff4fd8; clip-path: inset(55% 0 0 0); transform: translateX(.08em); }
    .glitch-slice::before { animation: label-slice-a .56s steps(2, end) both; }
    .glitch-slice::after { animation: label-slice-b .56s steps(2, end) both; }
    .glitch-flicker { animation: label-glitch-flicker .56s steps(4, end) both !important; text-shadow: 2px 0 #ff4fd8, -2px 0 #61d49a; }
    .glitch-flicker::before { animation: label-slice-b .56s steps(3, end) both; }
    .glitch-flicker::after { animation: label-slice-a .56s steps(3, end) both; }
    .glitch-scan::before { animation: label-scan-a .56s steps(5, end) both; clip-path: inset(15% 0 68% 0); }
    .glitch-scan::after { animation: label-scan-b .56s steps(5, end) both; clip-path: inset(70% 0 12% 0); }
    .glitch-burst { animation: label-burst .56s steps(2, end) both !important; }
    .glitch-burst::before { animation: label-slice-a .56s steps(2, end) both; text-shadow: 4px 0 #ff4fd8; }
    .glitch-burst::after { animation: label-slice-b .56s steps(2, end) both; text-shadow: -4px 0 #61d49a; }
    @keyframes label-glitch { 0%, 100% { transform: translateX(0); opacity: 1; } 20% { transform: translateX(-.04em); opacity: .75; } 45% { transform: translateX(.05em); opacity: .9; } 70% { transform: translateX(-.02em); opacity: .65; } }
    @keyframes label-glitch-flicker { 0%, 100% { opacity: 1; transform: skewX(0); } 25% { opacity: .1; transform: skewX(-8deg); } 50% { opacity: .85; transform: skewX(5deg); } 75% { opacity: .25; transform: skewX(-3deg); } }
    @keyframes label-burst { 0%, 100% { transform: scale(1); letter-spacing: .28em; } 35% { transform: scale(1.12); letter-spacing: .42em; opacity: .45; } 70% { transform: scale(.96); letter-spacing: .18em; } }
    @keyframes label-scan-a { 0%, 100% { transform: translateX(-.08em); } 25% { transform: translateX(.18em); } 50% { transform: translateX(-.2em); } 75% { transform: translateX(.1em); } }
    @keyframes label-scan-b { 0%, 100% { transform: translateX(.08em); } 25% { transform: translateX(-.16em); } 50% { transform: translateX(.2em); } 75% { transform: translateX(-.1em); } }
    @keyframes label-slice-a { 0%, 100% { transform: translateX(-.08em); } 50% { transform: translateX(.14em); } }
    @keyframes label-slice-b { 0%, 100% { transform: translateX(.08em); } 50% { transform: translateX(-.12em); } }
    @media (prefers-reduced-motion: reduce) { .total.is-spinning .digit-reel { transition: none; filter: none; } .money-label { margin-top: 2rem; opacity: 1; transform: none; } }
</style>
