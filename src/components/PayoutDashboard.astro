---
import gradesData from "../data/grades.json";
import { calculatePayout, PAYOUT_PER_A } from "../utils/payout";

const payout = calculatePayout(gradesData.classes);
const hasClasses = payout.classes.length > 0;
const currency = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
});
const formattedTotal = currency.format(payout.totalPayout);
const lastUpdated = gradesData.metadata.last_updated || "Waiting for first import";
---

<section class="payout-page" aria-labelledby="payout-heading">
    <div class="payout-kicker">
        <span class="kicker-rule" aria-hidden="true"></span>
        <span>Gavin's grade allowance</span>
        <span class="kicker-rule kicker-rule-right" aria-hidden="true"></span>
    </div>

    <div class="payout-intro">
        <div>
            <p class="eyebrow">Current snapshot / {lastUpdated}</p>
            <h1 id="payout-heading">Good grades<br /><em>pay off.</em></h1>
        </div>
        <p class="intro-copy">Every A is worth {currency.format(PAYOUT_PER_A)}. The number below is what today's grades have earned.</p>
    </div>

    <div class="payout-total-card">
        <div class="total-card-label">Total earned</div>
        <div class="total-amount" aria-label={`${formattedTotal} total earned`}>{formattedTotal}</div>
        <div class="total-card-footer">
            <span>{payout.qualifyingACount} {payout.qualifyingACount === 1 ? "A" : "As"} x {currency.format(PAYOUT_PER_A)}</span>
            <span class="total-dot" aria-hidden="true"></span>
            <span>Grades below A earn $0</span>
        </div>
    </div>

    <div class="breakdown-heading">
        <div>
            <p class="eyebrow">The breakdown</p>
            <h2>Where it comes from</h2>
        </div>
        <span class="class-count">{payout.classes.length} {payout.classes.length === 1 ? "class" : "classes"}</span>
    </div>

    {
        hasClasses ? (
            <div class="class-list" aria-label="Current class payout breakdown">
                {payout.classes.map((classInfo) => (
                    <a class={`class-row ${classInfo.qualifies ? "earns-payout" : "does-not-earn"}`} href={`/classes/${classInfo.period}`}>
                        <span class="period-number">{classInfo.period}</span>
                        <span class="class-name">{classInfo.className}</span>
                        <span class="class-grade">
                            <strong>{classInfo.grade === null ? "--" : `${classInfo.grade}%`}</strong>
                            <small>{classInfo.qualifies ? "A grade" : "Not an A"}</small>
                        </span>
                        <span class="class-payout" aria-label={classInfo.qualifies ? `${currency.format(PAYOUT_PER_A)} earned` : "No payout"}>
                            {classInfo.qualifies ? `+${currency.format(PAYOUT_PER_A)}` : "$0"}
                        </span>
                        <span class="row-arrow" aria-hidden="true">&#8599;</span>
                    </a>
                ))}
            </div>
        ) : (
            <div class="empty-state" role="status">
                <span class="empty-mark" aria-hidden="true">$</span>
                <div>
                    <h3>New year, clean slate.</h3>
                    <p>No current classes have been imported yet. Your total will appear here after the next grade update.</p>
                </div>
            </div>
        )
    }

    <p class="payout-footnote">An A means a current numeric grade of 90% or higher. Tap a class for its full grade details.</p>
</section>

<style>
    .payout-page { max-width: 900px; margin: 0 auto; padding: 3.5rem 0 5rem; }
    .payout-kicker { display: flex; align-items: center; gap: .75rem; color: var(--ledger-green); font: 700 .68rem/1 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
    .kicker-rule { width: 2.75rem; height: 1px; background: var(--ledger-green); }
    .kicker-rule-right { margin-left: auto; }
    .payout-intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin: 3.5rem 0 2.5rem; }
    .eyebrow { margin: 0 0 .75rem; color: var(--ledger-muted); font: 700 .65rem/1.4 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: 0; color: var(--ledger-ink); font: 700 clamp(3.3rem, 9vw, 7.2rem)/.88 "DM Serif Display", Georgia, serif; letter-spacing: -.055em; }
    h1 em { color: var(--ledger-green); font-style: italic; }
    .intro-copy { max-width: 18rem; margin-bottom: .3rem; color: var(--ledger-muted); font: 400 1rem/1.5 "DM Sans", sans-serif; }
    .payout-total-card { position: relative; overflow: hidden; padding: clamp(1.5rem, 5vw, 3rem); background: var(--ledger-green); color: #10251c; box-shadow: 10px 10px 0 #d6d2c8; }
    .payout-total-card::after { position: absolute; right: -1.4rem; bottom: -4rem; width: 12rem; height: 12rem; border: 1px solid rgba(16, 37, 28, .22); border-radius: 50%; box-shadow: 0 0 0 1rem rgba(16, 37, 28, .08), 0 0 0 2rem rgba(16, 37, 28, .06); content: ""; }
    .total-card-label { font: 700 .68rem/1 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
    .total-amount { margin: .8rem 0 1.5rem; font: 700 clamp(5rem, 17vw, 11rem)/.8 "DM Serif Display", Georgia, serif; letter-spacing: -.07em; }
    .total-card-footer { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; font: 700 .7rem/1.4 "DM Mono", monospace; letter-spacing: .04em; text-transform: uppercase; }
    .total-dot { width: .35rem; height: .35rem; background: currentColor; border-radius: 50%; }
    .breakdown-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin: 5rem 0 1.25rem; border-bottom: 1px solid var(--ledger-line); padding-bottom: 1rem; }
    .breakdown-heading h2 { margin-bottom: 0; color: var(--ledger-ink); font: 700 clamp(1.8rem, 4vw, 2.6rem)/1 "DM Serif Display", Georgia, serif; letter-spacing: -.04em; }
    .class-count { color: var(--ledger-muted); font: 700 .67rem/1 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
    .class-list { border-top: 2px solid var(--ledger-ink); }
    .class-row { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) 6rem 7rem 1.5rem; align-items: center; gap: 1rem; min-height: 5.5rem; border-bottom: 1px solid var(--ledger-line); color: var(--ledger-ink); text-decoration: none; transition: background .2s, padding .2s; }
    .class-row:hover, .class-row:focus-visible { padding-left: .75rem; background: rgba(20, 184, 111, .08); outline: none; }
    .period-number { color: var(--ledger-muted); font: 700 .72rem/1 "DM Mono", monospace; }
    .class-name { overflow: hidden; font: 700 1.08rem/1.2 "DM Sans", sans-serif; text-overflow: ellipsis; white-space: nowrap; }
    .class-grade { display: flex; flex-direction: column; gap: .25rem; }
    .class-grade strong { font: 700 1rem/1 "DM Mono", monospace; }
    .class-grade small { color: var(--ledger-muted); font: 700 .58rem/1 "DM Mono", monospace; text-transform: uppercase; }
    .class-payout { color: var(--ledger-muted); font: 700 1rem/1 "DM Mono", monospace; text-align: right; }
    .earns-payout .class-payout { color: var(--ledger-green-dark); }
    .row-arrow { color: var(--ledger-muted); font-size: 1.25rem; text-align: right; }
    .empty-state { display: flex; align-items: center; gap: 1.25rem; padding: 2rem; border: 1px dashed var(--ledger-line-strong); background: rgba(255, 255, 255, .38); }
    .empty-mark { display: grid; flex: 0 0 3.5rem; place-items: center; width: 3.5rem; height: 3.5rem; border: 1px solid var(--ledger-green); color: var(--ledger-green-dark); font: 700 1.5rem/1 "DM Serif Display", Georgia, serif; }
    .empty-state h3 { margin-bottom: .35rem; color: var(--ledger-ink); font: 700 1.5rem/1 "DM Serif Display", Georgia, serif; }
    .empty-state p { max-width: 34rem; margin-bottom: 0; color: var(--ledger-muted); font: 400 .9rem/1.5 "DM Sans", sans-serif; }
    .payout-footnote { margin: 1.5rem 0 0; color: var(--ledger-muted); font: 400 .72rem/1.5 "DM Mono", monospace; }
    @media (max-width: 640px) {
        .payout-page { padding-top: 2rem; }
        .payout-intro { display: block; margin-top: 2.5rem; }
        .intro-copy { margin-top: 1.5rem; }
        .total-card-footer { display: block; }
        .total-dot { display: inline-block; margin: 0 .5rem; }
        .class-row { grid-template-columns: 1.8rem minmax(0, 1fr) 4.5rem 1.5rem; gap: .6rem; min-height: 4.8rem; }
        .class-grade { display: none; }
        .class-name { font-size: .95rem; }
        .class-payout { font-size: .82rem; }
        .empty-state { align-items: start; padding: 1.25rem; }
    }
</style>
