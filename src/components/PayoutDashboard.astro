---
import gradesData from "../data/grades.json";
import missingAssignmentsData from "../data/missing_assignments.json";
import pointsProgressData from "../data/points_progress.json";
import fs from "node:fs/promises";
import path from "node:path";
import MarkingPeriodCard from "./MarkingPeriodCard.astro";
import { getMarkingPeriodStatus, schoolYear } from "../utils/schoolCalendar";
import { calculatePoints, MILESTONES } from "../utils/points";
import { applyProtectedProgress } from "../utils/pointsProgress";
import { formatDataUpdateTime, getLatestDataUpdate } from "../utils/dataFreshness";
import { getBadgeStatesWithApiArtwork } from "../utils/badges";
import BadgeCard from "./BadgeCard.astro";
import type { MissingPointAssignment } from "../utils/points";

type ScrapedAssignment = { name: string; dueDate: string | null; earnedPoints: number; totalPoints: number; weight?: number | null; graded: boolean };
type ScrapedClass = { className: string; period: string; assignments: ScrapedAssignment[] };
let scrapedClasses: ScrapedClass[] = [];
let scrapedAt: string | null = null;
try {
    const raw = await fs.readFile(path.resolve("scraper", "detailed-grades.json"), "utf8");
    const parsed = JSON.parse(raw) as { classes?: ScrapedClass[]; metadata?: { scrapedAt?: string } };
    scrapedClasses = parsed.classes ?? [];
    scrapedAt = parsed.metadata?.scrapedAt ?? null;
} catch { scrapedClasses = []; }

const periodStatus = getMarkingPeriodStatus();
const missingAssignments = (missingAssignmentsData.missing_assignments ?? []) as MissingPointAssignment[];
const rawPoints = calculatePoints(gradesData.classes, scrapedClasses, periodStatus.period, missingAssignments);
const points = applyProtectedProgress(rawPoints, pointsProgressData, schoolYear);
const hydratedBadges = await getBadgeStatesWithApiArtwork(points.totalPoints);
const currentBadge = hydratedBadges.find((badge) => badge.isCurrent) ?? hydratedBadges[0];
const dataUpdatedAt = formatDataUpdateTime(getLatestDataUpdate(gradesData.metadata.last_updated, scrapedAt));
const nextMilestone = points.nextMilestone ?? points.totalPoints;
const previousMilestone = points.nextMilestone === null ? Math.max(0, points.totalPoints - 500) : [...MILESTONES].filter((milestone) => milestone < points.nextMilestone).pop() ?? 0;
const milestoneRange = Math.max(1, nextMilestone - previousMilestone);
const milestoneProgress = Math.min(100, Math.round(((points.totalPoints - previousMilestone) / milestoneRange) * 100));
const periodLabel = periodStatus.period ? `MARKING PERIOD ${periodStatus.period.number}` : "POINTS QUEST";
const formattedPoints = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(points.totalPoints);
const formattedReady = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(points.readyToEarnPoints);
const formattedAwaiting = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 }).format(points.awaitingGradePoints);
const opportunityPreview = points.opportunities.slice(0, 5);
const assignmentGroups = Object.entries(points.assignments.reduce<Record<string, typeof points.assignments>>((groups, assignment) => {
    (groups[assignment.className] ??= []).push(assignment);
    return groups;
}, {}));
const assignmentStatusLabel = (status: typeof points.assignments[number]["status"]) => status === "completed" ? "COMPLETED" : status === "missing" ? "MISSING" : "NOT GRADED";
const assignmentStatusClass = (status: typeof points.assignments[number]["status"]) => status === "completed" ? "is-complete" : status === "missing" ? "is-missing" : "is-not-graded";
---

<section class="points-screen" aria-labelledby="points-heading">
    <div class="points-console">
        <header class="points-header">
            <div><p class="points-eyebrow">{periodLabel} / PROGRESS</p><h1 id="points-heading">GAVIN'S POINTS QUEST</h1></div>
            <span class="status-light" aria-label="Points system online">ONLINE</span>
        </header>
        <div class="points-hero">
            <div class="points-hero-label">TOTAL POINTS EARNED</div>
            <div class="points-value" aria-label={`${formattedPoints} points earned this marking period`}><span>{formattedPoints}</span><small>PTS</small></div>
            <p class="points-encouragement">{points.totalPoints > 0 ? "Every completed mission moves the meter." : "Your next point is ready when you are."}</p>
        </div>
        <section class="level-panel" aria-labelledby="level-heading">
            <div class="panel-heading"><div><p class="panel-kicker">LEVEL {points.level + 1}</p><h2 id="level-heading">NEXT MILESTONE: {nextMilestone.toLocaleString()} PTS</h2></div><strong class="points-to-go">{points.pointsToNextMilestone.toLocaleString()} TO GO</strong></div>
            <div class="milestone-track" role="progressbar" aria-label={`Progress toward ${nextMilestone} points`} aria-valuemin="0" aria-valuemax={nextMilestone} aria-valuenow={points.totalPoints}><span style={`width: ${milestoneProgress}%`}></span></div>
            <div class="milestone-meta"><span>{previousMilestone.toLocaleString()} PTS</span><span>{milestoneProgress}% COMPLETE</span><span>{nextMilestone.toLocaleString()} PTS</span></div>
        </section>
        <section class="current-badge-panel" aria-labelledby="current-badge-heading">
            <div class="panel-heading"><div><p class="panel-kicker">POWER LEVEL BADGE</p><h2 id="current-badge-heading">CURRENT CHARACTER</h2></div><a class="badge-room-link" href="/badges">OPEN BADGE ROOM</a></div>
            <a class="current-badge-link" href="/badges" aria-label="Open Badge Room to view all badges"><BadgeCard badge={currentBadge} compact /></a>
        </section>
        <div class="point-stats" aria-label="Point breakdown">
            <div class="stat-card"><span>ASSIGNMENT POINTS</span><strong>{points.assignmentPoints.toLocaleString()}</strong></div>
            <div class="stat-card"><span>FULL-CREDIT BONUSES</span><strong>+{points.fullCreditBonuses}</strong></div>
            <div class="stat-card"><span>A-GRADE BONUSES</span><strong>+{points.classGradeBonuses}</strong></div>
        </div>
        <section class="opportunity-panel" aria-labelledby="opportunity-heading">
            <div class="panel-heading opportunity-heading"><div><p class="panel-kicker">OPEN OPPORTUNITIES</p><h2 id="opportunity-heading">POINTS READY TO EARN</h2></div><div class="opportunity-totals"><strong class="opportunity-total">{formattedReady} READY</strong><span class="awaiting-total">{formattedAwaiting} AWAITING GRADES</span></div></div>
            {opportunityPreview.length > 0 ? <ul class="opportunity-list">{opportunityPreview.map((opportunity) => <li class:list={["opportunity-item", `is-${opportunity.opportunityType}`]}><span class="opportunity-mark" aria-hidden="true">+</span><span class="opportunity-name"><strong>{opportunity.assignmentName}</strong><small>{opportunity.className}</small></span><span class="opportunity-meta"><span class="opportunity-status">{opportunity.opportunityType === "missing" ? "MISSING" : "NOT GRADED"}</span><span class="opportunity-points">{opportunity.availablePoints} PTS</span></span></li>)}</ul> : <p class="opportunity-empty">No open missions. Keep building your streak.</p>}
            {points.opportunities.length > 5 && <button class="opportunity-more" type="button" data-opportunities-open>VIEW ALL OPPORTUNITIES <span>({points.opportunities.length})</span></button>}
        </section>
        <MarkingPeriodCard updatedAt={dataUpdatedAt} />
        <div class="dashboard-actions"><button class="breakdown-button" type="button" data-breakdown-open>VIEW ASSIGNMENT BREAKDOWN</button><button class="feedback-button" type="button" data-feedback-open>HOW POINTS WORK</button></div>
    </div>
    <dialog class="breakdown-dialog feedback-dialog" id="breakdown-dialog" aria-labelledby="breakdown-heading" aria-describedby="breakdown-intro"><button class="feedback-close" type="button" data-breakdown-close>Close</button><div class="breakdown-guide"><p class="guide-kicker">CURRENT MARKING PERIOD // DETAIL VIEW</p><h2 id="breakdown-heading">ASSIGNMENT BREAKDOWN</h2><p id="breakdown-intro">Current assignment scores and statuses are factual. Protected quest progress can remain higher after a correction or newly reported open work.</p><div class="breakdown-summary"><div><span>ASSIGNMENT POINTS</span><strong>{points.assignmentPoints.toLocaleString()}</strong></div><div><span>PERIOD POSSIBLE</span><strong>{points.availablePoints.toLocaleString()}</strong></div><div><span>READY TO EARN</span><strong>{points.readyToEarnPoints.toLocaleString()}</strong></div><div><span>AWAITING GRADES</span><strong>{points.awaitingGradePoints.toLocaleString()}</strong></div><div><span>BONUSES</span><strong>+{(points.fullCreditBonuses + points.classGradeBonuses).toLocaleString()}</strong></div><div><span>TOTAL POINTS EARNED / PROTECTED QUEST TOTAL</span><strong>{points.totalPoints.toLocaleString()}</strong></div></div>{assignmentGroups.length > 0 ? <div class="breakdown-groups">{assignmentGroups.map(([className, assignments]) => <section class="breakdown-class" aria-labelledby={`breakdown-class-${className.replace(/[^a-z0-9]+/gi, "-")}`}><h3 id={`breakdown-class-${className.replace(/[^a-z0-9]+/gi, "-")}`}>{className}</h3><ul>{assignments.map((assignment) => <li><span class="breakdown-assignment"><strong>{assignment.assignmentName}</strong><small>{assignment.dueDate || "DATE NOT AVAILABLE"}</small></span><span class="breakdown-score">{assignment.earnedPoints.toLocaleString()} / {assignment.possiblePoints.toLocaleString()} PTS</span><span class:list={["breakdown-status", assignmentStatusClass(assignment.status)]}>{assignmentStatusLabel(assignment.status)}</span></li>)}</ul></section>)}</div> : <p class="breakdown-empty">NO ASSIGNMENTS ARE LOGGED FOR THIS MARKING PERIOD YET.</p>}<p class="breakdown-bonus-note">BONUS SUMMARY: +{points.fullCreditBonuses} FULL-CREDIT / +{points.classGradeBonuses} A-GRADE</p></div></dialog>
    <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="points-guide-heading" aria-describedby="points-guide-intro"><button class="feedback-close" type="button" data-feedback-close>Close</button><div class="points-guide"><p class="guide-kicker">A QUIET GUIDE TO YOUR PROGRESS</p><h2 id="points-guide-heading">HOW YOUR POINTS GROW</h2><p id="points-guide-intro">This marking period is a chance to build momentum one completed assignment at a time.</p><ul><li><strong>ASSIGNMENT POINTS</strong><span>Earn the points you score on each assignment.</span></li><li><strong>FULL-CREDIT BONUS</strong><span>Get <b>+2</b> for every assignment completed for full credit.</span></li><li><strong>A-GRADE BONUS</strong><span>Get <b>+10</b> for every class currently at 90% or higher.</span></li><li><strong>OPEN OPPORTUNITIES</strong><span>Incomplete work does not take points away. It shows you where more points are waiting.</span></li></ul><p class="guide-footer">NEXT TARGET: {nextMilestone.toLocaleString()} POINTS.</p></div></dialog>
</section>

<dialog class="feedback-dialog" id="opportunities-dialog" aria-labelledby="opportunities-heading" aria-describedby="opportunities-intro">
    <button class="feedback-close" type="button" data-opportunities-close>Close</button>
    <div class="breakdown-guide">
        <p class="guide-kicker">CURRENT MARKING PERIOD // OPPORTUNITY VIEW</p>
        <h2 id="opportunities-heading">ALL OPPORTUNITIES</h2>
        <p id="opportunities-intro">Missing assignments need your attention. Not-graded assignments may simply be waiting for a teacher score.</p>
        <div class="opportunity-dialog-summary">
            <span><strong>{points.readyToEarnPoints.toLocaleString()}</strong> READY TO EARN</span>
            <span><strong>{points.awaitingGradePoints.toLocaleString()}</strong> AWAITING GRADES</span>
            <span><strong>{points.opportunities.filter((opportunity) => opportunity.opportunityType === "missing").length}</strong> MISSING ITEMS</span>
            <span><strong>{points.opportunities.filter((opportunity) => opportunity.opportunityType === "not-graded").length}</strong> NOT GRADED ITEMS</span>
        </div>
        <ul class="opportunity-dialog-list">
            {points.opportunities.map((opportunity) => <li class:list={[`is-${opportunity.opportunityType}`]}><span class="opportunity-name"><strong>{opportunity.assignmentName}</strong><small>{opportunity.className} / {opportunity.dueDate || "DATE NOT AVAILABLE"}</small></span><span class="opportunity-meta"><span class="opportunity-status">{opportunity.opportunityType === "missing" ? "MISSING" : "NOT GRADED"}</span><span class="opportunity-points">{opportunity.availablePoints} PTS</span></span></li>)}
        </ul>
    </div>
</dialog>

<script>
    const feedbackOpen = document.querySelector<HTMLButtonElement>("[data-feedback-open]");
    const feedbackDialog = document.querySelector<HTMLDialogElement>("#feedback-dialog");
    const feedbackClose = feedbackDialog?.querySelector<HTMLButtonElement>("[data-feedback-close]");
    const breakdownOpen = document.querySelector<HTMLButtonElement>("[data-breakdown-open]");
    const breakdownDialog = document.querySelector<HTMLDialogElement>("#breakdown-dialog");
    const breakdownClose = breakdownDialog?.querySelector<HTMLButtonElement>("[data-breakdown-close]");
    const opportunitiesOpen = document.querySelector<HTMLButtonElement>("[data-opportunities-open]");
    const opportunitiesDialog = document.querySelector<HTMLDialogElement>("#opportunities-dialog");
    const opportunitiesClose = opportunitiesDialog?.querySelector<HTMLButtonElement>("[data-opportunities-close]");
    let feedbackReturnFocus: HTMLElement | null = null;
    let breakdownReturnFocus: HTMLElement | null = null;
    let opportunitiesReturnFocus: HTMLElement | null = null;
    feedbackOpen?.addEventListener("click", () => { if (!feedbackDialog) return; feedbackReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null; feedbackDialog.showModal(); feedbackClose?.focus(); });
    feedbackClose?.addEventListener("click", () => feedbackDialog?.close());
    feedbackDialog?.addEventListener("click", (event) => { if (event.target === feedbackDialog) feedbackDialog.close(); });
    feedbackDialog?.addEventListener("close", () => { feedbackReturnFocus?.focus(); feedbackReturnFocus = null; });
    breakdownOpen?.addEventListener("click", () => { if (!breakdownDialog) return; breakdownReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null; breakdownDialog.showModal(); breakdownClose?.focus(); });
    breakdownClose?.addEventListener("click", () => breakdownDialog?.close());
    breakdownDialog?.addEventListener("click", (event) => { if (event.target === breakdownDialog) breakdownDialog.close(); });
    breakdownDialog?.addEventListener("close", () => { breakdownReturnFocus?.focus(); breakdownReturnFocus = null; });
    opportunitiesOpen?.addEventListener("click", () => { if (!opportunitiesDialog) return; opportunitiesReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null; opportunitiesDialog.showModal(); opportunitiesClose?.focus(); });
    opportunitiesClose?.addEventListener("click", () => opportunitiesDialog?.close());
    opportunitiesDialog?.addEventListener("click", (event) => { if (event.target === opportunitiesDialog) opportunitiesDialog.close(); });
    opportunitiesDialog?.addEventListener("close", () => { opportunitiesReturnFocus?.focus(); opportunitiesReturnFocus = null; });
</script>

<style>
    .points-screen { width: 100%; min-height: 100svh; padding: clamp(1.5rem, 4vw, 3rem) 0 2rem; color: #f2f5ef; }
    .points-console { width: min(92vw, 52rem); margin: 0 auto; }
    .points-header, .panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .points-header { border-bottom: 1px solid rgba(97, 212, 154, .3); padding-bottom: 1rem; }
    .points-eyebrow, .panel-kicker { margin: 0 0 .55rem; color: #61d49a; font: 700 .58rem/1.3 "DM Mono", monospace; letter-spacing: .16em; text-transform: uppercase; }
    .points-header h1 { margin: 0; color: #f2f5ef; font: 700 clamp(1.3rem, 5vw, 2.3rem)/1.05 "Orbitron", sans-serif; letter-spacing: .04em; }
    .status-light { flex: 0 0 auto; border: 1px solid rgba(97, 212, 154, .6); padding: .35rem .45rem; color: #61d49a; font: 700 .5rem/1 "DM Mono", monospace; letter-spacing: .12em; box-shadow: 0 0 14px rgba(97, 212, 154, .12); }
    .points-hero { position: relative; margin: 2rem 0 1.5rem; padding: 1.7rem 1rem 1.5rem; overflow: hidden; border: 1px solid rgba(97, 212, 154, .48); background: linear-gradient(135deg, rgba(15, 42, 35, .82), rgba(7, 17, 13, .55)); text-align: center; box-shadow: 0 0 0 1px rgba(255, 202, 58, .08), 0 1.2rem 3rem rgba(0, 0, 0, .25); }
    .points-hero::before { position: absolute; inset: 0; pointer-events: none; opacity: .23; background: repeating-linear-gradient(0deg, transparent 0 5px, rgba(97, 212, 154, .18) 6px, transparent 7px); content: ""; }
    .points-hero-label { position: relative; color: rgba(223, 255, 233, .72); font: 700 .62rem/1 "DM Mono", monospace; letter-spacing: .2em; }
    .points-value { position: relative; margin-top: .7rem; color: #f2f5ef; font: 700 clamp(4.6rem, 22vw, 11rem)/.86 "Orbitron", sans-serif; letter-spacing: .01em; text-shadow: 0 0 30px rgba(97, 212, 154, .3); }
    .points-value small { display: inline-block; margin-left: .45rem; color: #ffca3a; font: 700 clamp(.75rem, 3vw, 1.3rem)/1 "DM Mono", monospace; letter-spacing: .12em; vertical-align: middle; }
    .points-encouragement { position: relative; margin: 1rem 0 0; color: #b6ffd0; font: 400 .72rem/1.45 "DM Mono", monospace; letter-spacing: .04em; }
    .level-panel, .opportunity-panel { margin-top: 1rem; border: 1px solid rgba(97, 212, 154, .3); padding: 1rem; background: rgba(8, 20, 15, .78); }
    .panel-kicker { margin-bottom: .35rem; color: #ffca3a; }
    .panel-heading h2 { margin: 0; color: #f2f5ef; font: 700 clamp(.8rem, 3vw, 1.1rem)/1.2 "Orbitron", sans-serif; letter-spacing: .05em; }
    .points-to-go, .opportunity-total { flex: 0 0 auto; color: #61d49a; font: 700 .62rem/1.2 "DM Mono", monospace; letter-spacing: .05em; text-align: right; }
    .opportunity-totals { display: grid; flex: 0 0 auto; justify-items: end; gap: .3rem; }
    .awaiting-total { color: #9fbea8; font: 500 .52rem/1.2 "DM Sans", sans-serif; letter-spacing: .04em; text-align: right; }
    .milestone-track { height: .65rem; margin-top: 1.15rem; overflow: hidden; border: 1px solid rgba(97, 212, 154, .38); background: rgba(0, 0, 0, .5); }
    .milestone-track span { display: block; height: 100%; background: repeating-linear-gradient(135deg, #61d49a 0 9px, #b6ffd0 9px 12px); box-shadow: 0 0 18px rgba(97, 212, 154, .78); transition: width .45s ease; }
    .milestone-meta { display: flex; justify-content: space-between; margin-top: .5rem; color: rgba(223, 255, 233, .58); font: 700 .5rem/1 "DM Mono", monospace; letter-spacing: .06em; }
    .point-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; margin-top: .65rem; }
    .stat-card { min-width: 0; border: 1px solid rgba(97, 212, 154, .2); padding: .75rem .65rem; background: rgba(15, 42, 35, .4); }
    .stat-card span { display: block; color: rgba(223, 255, 233, .62); font: 700 .48rem/1.3 "DM Mono", monospace; letter-spacing: .08em; }
    .stat-card strong { display: block; margin-top: .45rem; color: #f2f5ef; font: 700 clamp(1rem, 4vw, 1.35rem)/1 "Orbitron", sans-serif; }
    .opportunity-heading { align-items: center; }
    .opportunity-list { display: grid; gap: .45rem; margin: 1rem 0 0; padding: 0; list-style: none; }
    .opportunity-list li { display: flex; align-items: center; gap: .7rem; border-left: 2px solid #ffca3a; padding: .65rem .7rem; background: rgba(255, 202, 58, .06); }
    .opportunity-item.is-not-graded { border-left-color: #61d49a; background: rgba(97, 212, 154, .045); }
    .opportunity-mark { color: #ffca3a; font: 700 1.3rem/1 "Orbitron", sans-serif; }
    .opportunity-name { display: grid; min-width: 0; gap: .2rem; flex: 1; }
    .opportunity-name strong { overflow-wrap: anywhere; color: #f2f5ef; font: 700 .67rem/1.3 "DM Mono", monospace; text-transform: uppercase; }
    .opportunity-name small { overflow-wrap: anywhere; color: rgba(223, 255, 233, .58); font: 400 .6rem/1.3 "DM Mono", monospace; }
    .opportunity-points { flex: 0 0 auto; color: #ffca3a; font: 700 .6rem/1 "DM Mono", monospace; }
    .opportunity-meta { display: grid; flex: 0 0 auto; justify-items: end; gap: .3rem; }
    .opportunity-status { color: #c7aa72; font: 700 .47rem/1 "DM Sans", sans-serif; letter-spacing: .07em; white-space: nowrap; }
    .is-not-graded .opportunity-status { color: #9fbea8; }
    .opportunity-empty, .opportunity-more { margin: 1rem 0 .15rem; color: #b6ffd0; font: 700 .62rem/1.4 "DM Mono", monospace; letter-spacing: .04em; text-transform: uppercase; }
    .opportunity-more { width: 100%; border: 1px solid rgba(199, 170, 114, .32); border-radius: 999px; padding: .65rem .8rem; color: #c7aa72; background: rgba(199, 170, 114, .04); text-align: center; cursor: pointer; }
    .opportunity-more:hover, .opportunity-more:focus-visible { color: #17140d; background: #c7aa72; outline: none; }
    .marking-period-card { margin-top: 1.5rem; }
    .feedback-button { display: block; margin: 2rem auto 0; border: 1px solid rgba(97, 212, 154, .7); padding: .7rem 1rem; color: #61d49a; background: rgba(10, 20, 16, .72); font: 700 .62rem/1 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: color .2s ease, background .2s ease, transform .2s ease; }
    .feedback-button:hover, .feedback-button:focus-visible { color: #07110d; background: #61d49a; transform: translateY(-2px); }
    .feedback-dialog { box-sizing: border-box; width: 100vw; max-width: none; height: 100svh; max-height: none; margin: 0; border: 0; padding: clamp(2rem, 6vw, 5rem); color: #61d49a; background: #07110d; font: 400 clamp(.8rem, 2.4vw, 1rem)/1.5 "DM Mono", monospace; text-align: center; }
    .feedback-dialog[open] { display: grid; place-items: center; }
    :global(body:has(dialog[open])) { overflow: hidden; }
    .feedback-dialog::backdrop { background: rgba(2, 7, 5, .82); backdrop-filter: blur(3px); }
    .points-guide { width: min(100%, 36rem); border: 1px solid rgba(97, 212, 154, .48); padding: clamp(1.25rem, 4vw, 2.5rem); background: linear-gradient(135deg, rgba(15, 42, 35, .82), rgba(7, 17, 13, .55)); text-align: left; box-shadow: 0 0 0 1px rgba(255, 202, 58, .08), 0 1rem 3rem rgba(0, 0, 0, .3); }
    .guide-kicker { margin: 0 0 .65rem; color: #ffca3a; font: 700 .55rem/1 "DM Mono", monospace; letter-spacing: .16em; }
    .points-guide h2 { margin: 0; color: #f2f5ef; font: 700 clamp(1.3rem, 5vw, 2rem)/1.1 "Orbitron", sans-serif; letter-spacing: .04em; }
    #points-guide-intro { margin: .8rem 0 1.4rem; color: rgba(223, 255, 233, .72); }
    .points-guide ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
    .points-guide li { display: grid; gap: .2rem; border-left: 2px solid #61d49a; padding: .65rem .75rem; background: rgba(97, 212, 154, .06); }
    .points-guide li strong { color: #b6ffd0; font: 700 .72rem/1.2 "DM Mono", monospace; text-transform: uppercase; }
    .points-guide li span { color: rgba(223, 255, 233, .68); font-size: .7rem; }
    .points-guide li b { color: #ffca3a; }
    .guide-footer { margin: 1.35rem 0 0; color: #ffca3a; font: 700 .68rem/1.3 "DM Mono", monospace; letter-spacing: .05em; text-transform: uppercase; }
    .feedback-close { position: absolute; top: clamp(1rem, 3vw, 2rem); right: clamp(1rem, 3vw, 2rem); border: 1px solid rgba(97, 212, 154, .7); padding: .65rem .8rem; color: #61d49a; background: transparent; font: 700 .65rem/1 "DM Mono", monospace; text-transform: uppercase; cursor: pointer; }
    .feedback-close:hover, .feedback-close:focus-visible { color: #07110d; background: #61d49a; outline: none; }
    /* Softer dark study-room treatment: keep the caps, lower the visual volume. */
    .points-screen { padding-top: clamp(2rem, 5vw, 4rem); color: #e8eee9; font-family: "DM Sans", sans-serif; }
    .points-header { border-bottom-color: rgba(174, 202, 184, .18); padding-bottom: 1.25rem; }
    .points-eyebrow, .panel-kicker { color: #9fbea8; font-family: "DM Sans", sans-serif; font-weight: 700; letter-spacing: .13em; }
    .points-header h1 { color: #e8eee9; font-family: "DM Sans", sans-serif; font-size: clamp(1.25rem, 4.4vw, 2rem); font-weight: 500; letter-spacing: .08em; }
    .status-light { border-color: rgba(159, 190, 168, .35); border-radius: 999px; color: #9fbea8; font-family: "DM Sans", sans-serif; font-weight: 500; letter-spacing: .1em; box-shadow: none; }
