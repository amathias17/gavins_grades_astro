---
import { getMarkingPeriodStatus, getSchoolDayReminder } from "../utils/schoolCalendar";

const initialStatus = getMarkingPeriodStatus();
const initialReminder = getSchoolDayReminder();
const initialPeriodLabel = initialStatus.period ? `MARKING PERIOD ${initialStatus.period.number}` : initialStatus.label;
---

<aside
    class="marking-period-card"
    data-marking-period-card
    data-status={JSON.stringify(initialStatus)}
    aria-labelledby="marking-period-heading"
>
    <div class="marking-period-meta">
        <span id="marking-period-heading" class="marking-period-kicker">{initialPeriodLabel}</span>
    </div>
    <strong class="marking-period-label" data-marking-period-label>{initialStatus.label}</strong>
    <span class="marking-period-detail" data-marking-period-detail>{initialStatus.detail}</span>
    <div class="marking-period-track" aria-hidden="true">
        <span class="marking-period-progress" data-marking-period-progress style={`width: ${initialStatus.progressPercent}%`}></span>
    </div>
    <div class:list={["school-reminder", `school-reminder-${initialReminder.tone}`]} data-school-reminder hidden={initialReminder.isCheckpoint}>
        <span class="school-reminder-tag">REMINDER</span>
        <strong data-school-reminder-label>{initialReminder.label}</strong>
        <span data-school-reminder-detail>{initialReminder.detail}</span>
    </div>
    <span class="sr-only" data-marking-period-announcement aria-live="polite"></span>
</aside>

<script>
    import { getMarkingPeriodStatus, getSchoolDayReminder } from "../utils/schoolCalendar";

    const card = document.querySelector<HTMLElement>("[data-marking-period-card]");
    const label = card?.querySelector<HTMLElement>("[data-marking-period-label]");
    const detail = card?.querySelector<HTMLElement>("[data-marking-period-detail]");
    const progress = card?.querySelector<HTMLElement>("[data-marking-period-progress]");
    const heading = card?.querySelector<HTMLElement>("#marking-period-heading");
    const announcement = card?.querySelector<HTMLElement>("[data-marking-period-announcement]");
    const reminder = card?.querySelector<HTMLElement>("[data-school-reminder]");
    const reminderLabel = card?.querySelector<HTMLElement>("[data-school-reminder-label]");
    const reminderDetail = card?.querySelector<HTMLElement>("[data-school-reminder-detail]");

    const update = () => {
        const status = getMarkingPeriodStatus(new Date());
        const nextReminder = getSchoolDayReminder(new Date());
        const periodLabel = status.period ? `MARKING PERIOD ${status.period.number}` : status.label;
        if (heading) heading.textContent = periodLabel;
        if (label) label.textContent = status.label;
        if (detail) detail.textContent = status.detail;
        if (progress) progress.style.width = `${status.progressPercent}%`;
        if (reminder) {
            reminder.className = `school-reminder school-reminder-${nextReminder.tone}`;
            reminder.hidden = Boolean(nextReminder.isCheckpoint);
        }
        if (reminderLabel) reminderLabel.textContent = nextReminder.label;
        if (reminderDetail) reminderDetail.textContent = nextReminder.detail;
        if (announcement) {
            const reminderAnnouncement = nextReminder.isCheckpoint ? "" : ` ${nextReminder.label}. ${nextReminder.detail}`;
            announcement.textContent = `${periodLabel}. ${status.label}. ${status.detail}.${reminderAnnouncement}`;
        }
    };

    update();
    const millisecondsUntilTomorrow = () => {
        const tomorrow = new Date();
        tomorrow.setHours(24, 0, 5, 0);
        return tomorrow.getTime() - Date.now();
    };
    window.setTimeout(() => {
        update();
        window.setInterval(update, 24 * 60 * 60 * 1000);
    }, millisecondsUntilTomorrow());
</script>

<style>
    .marking-period-card {
        width: 100%;
        margin: 1rem 0 0;
        padding: 1rem;
        border: 1px solid rgba(174, 202, 184, .16);
        border-radius: .9rem;
        background: rgba(12, 23, 18, .48);
        box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, .12);
        color: var(--ledger-ink);
        font-family: "DM Sans", sans-serif;
        text-align: left;
    }

    .marking-period-meta {
        display: block;
        color: var(--ledger-green);
        font: 700 .68rem/1.2 "DM Mono", monospace;
        letter-spacing: .1em;
        line-height: 1.3;
    }

    .marking-period-label { display: block; margin-top: .65rem; color: var(--ledger-ink); font: 600 clamp(1.15rem, 4vw, 1.55rem)/1.15 "DM Sans", sans-serif; letter-spacing: .02em; }
    .marking-period-detail { display: block; margin-top: .45rem; color: var(--ledger-muted); font-size: .75rem; line-height: 1.4; }
    .marking-period-track { height: .45rem; margin-top: .9rem; overflow: hidden; border: 1px solid var(--ledger-line-strong); border-radius: 999px; background: var(--ledger-surface); }
    .marking-period-progress { display: block; height: 100%; min-width: 0; border-radius: inherit; background: var(--ledger-green); box-shadow: none; transition: width .45s ease; }
    .school-reminder { display: grid; grid-template-columns: auto 1fr; gap: .25rem .55rem; margin-top: 1rem; border-left: 2px solid var(--ledger-green); padding: .7rem; background: rgba(159, 190, 168, .05); }
    .school-reminder-tag { grid-column: 1 / -1; color: var(--ledger-muted); font: 700 .48rem/1.2 "DM Mono", monospace; letter-spacing: .12em; }
    .school-reminder strong { color: var(--ledger-ink); font-size: .68rem; letter-spacing: .03em; line-height: 1.35; }
    .school-reminder > span:last-child { color: var(--ledger-muted); font-size: .65rem; line-height: 1.4; }
    .school-reminder-notice { border-left-color: var(--ledger-sand); }
    .school-reminder-notice strong { color: var(--ledger-sand); }
    .school-reminder-special { border-left-color: var(--ledger-green); }
    .school-reminder-special strong { color: var(--ledger-green); }

    @media (prefers-reduced-motion: reduce) {
        .marking-period-progress { transition: none; }
    }
</style>
