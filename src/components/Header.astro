---
---

<header class="site-header" role="banner">
    <a class="brand" href="/" aria-label="Gavin's allowance home">
        <span class="brand-mark" aria-hidden="true">$</span>
        <span><strong>GAVIN'S</strong><small>GRADE ALLOWANCE</small></span>
    </a>
    <nav aria-label="Primary navigation">
        <a class="active" href="/">Overview</a>
        <a href="/stats">Stats</a>
        <a href="/history">History</a>
        <a href="/calculator">Calculator</a>
    </nav>
</header>

<style>
    .site-header { display: flex; align-items: center; justify-content: space-between; gap: 2rem; max-width: 1100px; margin: 0 auto; padding: 1.5rem 0; border-bottom: 1px solid var(--ledger-line); }
    .brand { display: flex; align-items: center; gap: .7rem; color: var(--ledger-ink); text-decoration: none; }
    .brand-mark { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 1px solid var(--ledger-green); color: var(--ledger-green-dark); font: 700 1.15rem/1 "DM Serif Display", Georgia, serif; }
    .brand strong, .brand small { display: block; }
    .brand strong { font: 700 .8rem/1 "DM Mono", monospace; letter-spacing: .08em; }
    .brand small { margin-top: .25rem; color: var(--ledger-muted); font: 700 .52rem/1 "DM Mono", monospace; letter-spacing: .08em; }
    nav { display: flex; flex-wrap: wrap; justify-content: end; gap: 1.4rem; }
    nav a { position: relative; color: var(--ledger-muted); font: 700 .65rem/1 "DM Mono", monospace; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
    nav a:hover, nav a:focus-visible, nav a.active { color: var(--ledger-ink); }
    nav a.active::after { position: absolute; right: 0; bottom: -.55rem; left: 0; height: 2px; background: var(--ledger-green); content: ""; }
    @media (max-width: 640px) { .site-header { align-items: start; flex-direction: column; gap: 1.25rem; } nav { justify-content: start; gap: 1rem; } }
</style>
