---
import type { BadgeState } from "../utils/badges";

interface Props {
    badge: BadgeState;
    compact?: boolean;
}

const { badge, compact = false } = Astro.props;
const isLocked = !badge.unlocked;
---

<article class:list={["badge-card", { "badge-card-compact": compact, "is-current": badge.isCurrent, "is-locked": isLocked, "is-final": badge.isFinal }]} aria-label={isLocked ? `Level ${badge.level} badge, locked, ${badge.unlockPoints.toLocaleString()} points to unlock` : `${badge.characterName} badge, unlocked`}>
    <div class="badge-art" data-badge-art>
        {isLocked ? <span class="badge-mystery-silhouette" aria-hidden="true"><span class="silhouette-head"></span><span class="silhouette-body"></span></span> : <>
            <span class="badge-placeholder" aria-hidden="true">{badge.characterName.slice(0, 2).toUpperCase()}</span>
            {badge.imagePath && <img src={badge.imagePath} alt={`${badge.characterName} headshot`} loading="lazy" />}
        </>}
        {isLocked && <span class="badge-lock" aria-hidden="true">LOCKED</span>}
    </div>
    <div class="badge-copy">
        <span class="badge-kicker">LEVEL {badge.level} {!isLocked && badge.isFinal && "// FINAL BADGE"}</span>
        <h3>{isLocked ? "LOCKED BADGE" : badge.characterName}</h3>
        {!badge.isCurrent && <span class="badge-status">{isLocked ? `${badge.unlockPoints.toLocaleString()} PTS TO UNLOCK` : "UNLOCKED"}</span>}
        {badge.isCurrent && compact && <span class="badge-status">{badge.unlockPoints.toLocaleString()} PTS MILESTONE</span>}
        {!isLocked && <dl class="badge-stats">
            <div><dt>AFFILIATION</dt><dd>{badge.affiliation ?? "UNKNOWN"}</dd></div>
            <div><dt>BASE KI</dt><dd>{badge.baseKi ?? "UNKNOWN"}</dd></div>
            <div><dt>TOTAL KI</dt><dd>{badge.totalKi ?? "UNKNOWN"}</dd></div>
        </dl>}
    </div>
</article>

<script>
    document.querySelectorAll<HTMLElement>("[data-badge-art]").forEach((art) => {
        const image = art.querySelector<HTMLImageElement>("img");
        if (!image) return;
        const showImage = () => art.classList.add("has-image");
        const removeImage = () => image.remove();
        image.addEventListener("load", showImage, { once: true });
        image.addEventListener("error", removeImage, { once: true });
        if (image.complete && image.naturalWidth > 0) showImage();
    });
</script>

<style>
    .badge-card { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr); gap: .9rem; align-items: center; border: 1px solid rgba(174, 202, 184, .14); border-radius: .9rem; padding: .75rem; background: rgba(24, 40, 30, .28); }
    .badge-card.is-current { border-color: rgba(208, 183, 131, .5); background: linear-gradient(135deg, rgba(208, 183, 131, .09), rgba(166, 196, 167, .045)); box-shadow: 0 1rem 2rem rgba(0, 0, 0, .14); }
    .badge-card.is-locked { opacity: .58; }
    .badge-art { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid rgba(166, 196, 167, .36); border-radius: .75rem; background: radial-gradient(ellipse at 50% 24%, rgba(208, 183, 131, .24), rgba(23, 28, 24, .98) 68%); color: var(--ledger-sand, #d0b783); font: 700 .95rem/1 "Orbitron", sans-serif; }
    .badge-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 8%; transform: scale(1.42); transform-origin: center top; opacity: 1; transition: opacity .2s ease; }
    .badge-mystery-silhouette { position: relative; display: block; width: 70%; height: 78%; overflow: hidden; border-radius: 50% 50% 34% 34%; background: linear-gradient(180deg, #101914, #070c09); box-shadow: 0 0 1.2rem rgba(0, 0, 0, .5); }
    .silhouette-head { position: absolute; top: 11%; left: 25%; width: 50%; aspect-ratio: 1; border-radius: 50%; background: #070c09; }
    .silhouette-body { position: absolute; right: 8%; bottom: -25%; left: 8%; height: 68%; border-radius: 50% 50% 20% 20%; background: #070c09; }
    .badge-lock { position: absolute; right: .25rem; bottom: .2rem; border-radius: 999px; padding: .18rem .28rem; color: #101d16; background: var(--ledger-sand, #d0b783); font: 700 .38rem/1 "DM Sans", sans-serif; letter-spacing: .05em; }
    .badge-copy { min-width: 0; }
    .badge-kicker, .badge-status { display: block; color: var(--ledger-green, #a6c4a7); font: 700 .58rem/1.25 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
    .badge-copy h3 { margin: .35rem 0 0; overflow-wrap: anywhere; color: var(--ledger-ink, #f0eee5); font: 600 clamp(1rem, 3vw, 1.2rem)/1.15 "DM Sans", sans-serif; letter-spacing: .02em; }
    .badge-status { margin-top: .35rem; color: var(--ledger-muted, #a2a79d); letter-spacing: .06em; }
    .badge-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .35rem; margin: .7rem 0 0; border-top: 1px solid rgba(174, 202, 184, .14); padding-top: .55rem; }
    .badge-stats div { min-width: 0; }
    .badge-stats dt { color: var(--ledger-muted, #a2a79d); font: 700 .5rem/1.2 "DM Mono", monospace; letter-spacing: .06em; }
    .badge-stats dd { overflow-wrap: anywhere; margin: .25rem 0 0; color: var(--ledger-ink, #f0eee5); font: 600 .6rem/1.25 "DM Sans", sans-serif; }
    @media (max-width: 420px) {
        .badge-card { grid-template-columns: 4.8rem minmax(0, 1fr); gap: .7rem; padding: .65rem; }
        .badge-stats { grid-template-columns: 1fr; gap: .45rem; }
    }
    /* Dashboard badge follows the Classes ledger rather than a nested trophy card. */
    .badge-card-compact, .badge-card-compact.is-current { grid-template-columns: 5.2rem minmax(0, 1fr); gap: 1.25rem; border: 0; border-radius: 0; padding: 0; background: transparent; box-shadow: none; }
    .badge-card-compact .badge-art { border-color: var(--ledger-line); border-radius: .55rem; background: var(--ledger-surface-raised); color: var(--ledger-sand); font: 600 1.25rem/1 "DM Sans", sans-serif; }
    .badge-card-compact .badge-kicker { color: var(--ledger-green); font: 700 .68rem/1.3 "DM Mono", monospace; letter-spacing: .08em; }
    .badge-card-compact .badge-copy h3 { margin: .4rem 0 0; overflow-wrap: anywhere; color: var(--ledger-ink); font: 600 1.35rem/1.3 "DM Sans", sans-serif; letter-spacing: .01em; }
    .badge-card-compact .badge-stats { gap: 1rem; margin-top: .8rem; border-color: var(--ledger-line); padding-top: .75rem; }
    .badge-card-compact .badge-stats dt { color: var(--ledger-muted); font: 500 .62rem/1.4 "DM Mono", monospace; letter-spacing: .04em; }
    .badge-card-compact .badge-stats dd { margin-top: .35rem; color: var(--ledger-ink); font: 500 .82rem/1.4 "DM Sans", sans-serif; }
    @media (max-width: 520px) {
        .badge-card-compact { gap: 1rem; align-items: start; }
        .badge-card-compact .badge-stats { grid-template-columns: 1fr; gap: .45rem; }
        .badge-card-compact .badge-stats div { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; }
        .badge-card-compact .badge-stats dt { flex-shrink: 0; }
        .badge-card-compact .badge-stats dd { margin: 0; text-align: right; }
    }
    @media (prefers-reduced-motion: reduce) { .badge-art img { transition: none; } }
</style>
