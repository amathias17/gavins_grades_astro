---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gradesData from "../../data/grades.json";
import type { Class, Assignment } from "../../types/grades";
import fs from "node:fs/promises";
import path from "node:path";
import { getClassRouteKey, normalizeClassName } from "../../utils/classRoutes";

type ScrapedAssignment = {
  name: string;
  dueDate: string | null;
  earnedPoints: number;
  totalPoints: number;
  graded: boolean;
};

type ScrapedClass = {
  className: string;
  period: string;
  assignments: ScrapedAssignment[];
};

type ScrapedGrades = {
  classes?: ScrapedClass[];
};

export async function getStaticPaths() {
  const normalizePeriod = (value: string): string => value.trim();

  const classes = gradesData.classes as Class[];
  let scrapedClasses: ScrapedClass[] = [];
  try {
    const scrapedPath = path.resolve("scraper", "detailed-grades.json");
    const raw = await fs.readFile(scrapedPath, "utf8");
    const parsed = JSON.parse(raw) as ScrapedGrades;
    scrapedClasses = parsed?.classes ?? [];
  } catch (error) {
    scrapedClasses = [];
  }
  const scrapedByName = new Map(
    scrapedClasses.map((entry) => [normalizeClassName(entry.className), entry])
  );
  const classesByPeriod = new Map<string, Class[]>();
  for (const classInfo of classes) {
    const entries = classesByPeriod.get(normalizePeriod(classInfo.period)) ?? [];
    entries.push(classInfo);
    classesByPeriod.set(normalizePeriod(classInfo.period), entries);
  }
  const scrapedByPeriod = new Map<string, ScrapedClass[]>();
  for (const entry of scrapedClasses) {
    const period = normalizePeriod(entry.period);
    const entries = scrapedByPeriod.get(period) ?? [];
    entries.push(entry);
    scrapedByPeriod.set(period, entries);
  }
  return classes.map((classInfo) => ({
    params: { classId: getClassRouteKey(classInfo, classes) },
    props: (() => {
      const periodKey = normalizePeriod(classInfo.period);
      const nameKey = normalizeClassName(classInfo.class_name);
      const scrapedMatch = scrapedByName.get(nameKey) ??
        (classesByPeriod.get(periodKey)?.length === 1 && scrapedByPeriod.get(periodKey)?.length === 1
          ? scrapedByPeriod.get(periodKey)?.[0]
          : undefined);
      return {
        classInfo,
        scrapedAssignments: scrapedMatch?.assignments ?? [],
      };
    })(),
  }));
}

function toAssignment(
  scraped: ScrapedAssignment,
  classInfo: Class
): Assignment {
  const maxPoints = Number.isFinite(scraped.totalPoints) ? scraped.totalPoints : 0;
  const dueDate = scraped.dueDate ?? "N/A";
  const isNotGraded = !scraped.graded && maxPoints > 0;
  const isMissing = !isNotGraded && maxPoints > 0 && isPastDue(dueDate);
  const hasScore = scraped.graded && maxPoints > 0;
  const percentage = hasScore
    ? Math.round((scraped.earnedPoints / maxPoints) * 10000) / 100
    : isMissing
    ? 0
    : null;
  const idParts = [classInfo.class_id || classInfo.period, scraped.name, dueDate];

  return {
    id: idParts.filter(Boolean).join(":"),
    name: scraped.name,
    category: "Scraped",
    dueDate,
    score: hasScore ? scraped.earnedPoints : isMissing ? 0 : isNotGraded ? 0 : null,
    maxPoints,
    percentage,
    status: hasScore
      ? "graded"
      : isMissing
      ? "missing"
      : isNotGraded
      ? "not-graded"
      : "pending",
  };
}

const { classInfo, scrapedAssignments } = Astro.props as {
  classInfo: Class;
  scrapedAssignments: ScrapedAssignment[];
};
const scrapedAssignmentRows = scrapedAssignments.map((assignment) =>
  toAssignment(assignment, classInfo)
);

function getGradeColor(grade: number): string {
  if (grade >= 90) return "grade-a";
  if (grade >= 80) return "grade-b";
  if (grade >= 70) return "grade-c";
  if (grade >= 60) return "grade-d";
  return "grade-f";
}

function parseDueDate(value: string): Date | null {
  const match = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (!match) return null;
  const month = Number(match[1]);
  const day = Number(match[2]);
  const year = Number(match[3]);
  if (!month || !day || !year) return null;
  const date = new Date(year, month - 1, day);
  return Number.isNaN(date.getTime()) ? null : date;
}

function isPastDue(value: string): boolean {
  const parsed = parseDueDate(value);
  if (!parsed) return false;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return parsed.getTime() <= today.getTime();
}

function normalizeAssignments(items: Assignment[]): Assignment[] {
  return items.map((assignment) => {
    const inferredStatus =
      assignment.status ?? (assignment.score !== null ? "graded" : "pending");
    if (inferredStatus === "not-graded") {
      return { ...assignment, status: "not-graded", score: assignment.score ?? 0 };
    }

    const isMissing =
      (inferredStatus === "missing" ||
        (inferredStatus === "pending" &&
          assignment.maxPoints > 0 &&
          isPastDue(assignment.dueDate))) &&
      assignment.maxPoints > 0;

    if (isMissing) {
      return {
        ...assignment,
        status: "missing",
        score: assignment.score ?? 0,
        percentage: assignment.percentage ?? 0,
      };
    }

    return { ...assignment, status: inferredStatus };
  });
}

function getScoreDisplay(assignment: Assignment): string {
  if (assignment.maxPoints > 0 && (assignment.score === null || assignment.status !== "graded")) {
    return `0/${assignment.maxPoints}`;
  }
  if (assignment.score === null) {
    return "PENDING";
  }
  return `${assignment.score}/${assignment.maxPoints}`;
}

function getPercentageDisplay(assignment: Assignment): string {
  if (assignment.percentage === null) {
    return "0%";
  }
  return `${Math.round(assignment.percentage)}%`;
}

const assignments = normalizeAssignments(
  scrapedAssignmentRows.length > 0
    ? scrapedAssignmentRows
    : classInfo.assignments || []
);
const hasAssignments = assignments.length > 0;
---

<BaseLayout>
  <div class="class-page">
    <!-- Back Navigation -->
    <div class="class-back-wrap">
      <a
        href="/"
        class="class-back-link"
      >
        <span>← BACK TO GRADES</span>
      </a>
    </div>

    <!-- Class Header Card -->
    <section class="class-header-card" aria-labelledby="class-title">
        <div
          class="class-header-top"
        >
        <div
          class="class-icon"
        >
          📊
        </div>
        <div class="flex-1">
          <p class="class-kicker">
            CLASS.DETAILS - PERIOD {classInfo.period}
          </p>
          <h1 id="class-title">
            {classInfo.class_name}
          </h1>
        </div>
      </div>

      <div class="class-overview-grid">
        <div class="class-info-card">
          <span>TEACHER</span>
          <strong>{classInfo.teacher}</strong>
        </div>

        <div class="class-info-card">
          <span>CURRENT GRADE</span>
          <div class="class-grade-values">
            <span
              class={`grade-badge ${getGradeColor(classInfo.current_grade)}`}
            >
              {classInfo.letter_grade}
            </span>
            <span
              class={`grade-badge ${getGradeColor(classInfo.current_grade)}`}
            >
              {classInfo.current_grade}%
            </span>
          </div>
        </div>

        {
          classInfo.q1_grade !== null && (
            <div class="class-info-card">
              <span>Q1 GRADE</span>
              <div class="class-grade-values">
                <span
                  class={`grade-badge ${getGradeColor(classInfo.q1_grade)}`}
                >
                  {classInfo.q1_letter_grade}
                </span>
                <span
                  class={`grade-badge ${getGradeColor(classInfo.q1_grade)}`}
                >
                  {classInfo.q1_grade}%
                </span>
              </div>
            </div>
          )
        }

        {
          classInfo.q2_grade !== null && (
            <div class="class-info-card">
              <span>Q2 GRADE</span>
              <div class="class-grade-values">
                <span
                  class={`grade-badge ${getGradeColor(classInfo.q2_grade)}`}
                >
                  {classInfo.q2_letter_grade}
                </span>
                <span
                  class={`grade-badge ${getGradeColor(classInfo.q2_grade)}`}
                >
                  {classInfo.q2_grade}%
                </span>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <!-- Assignments Section -->
    <section class="assignments-panel" aria-labelledby="assignments-heading">
      <div
        class="assignments-heading"
      >
        <div
          class="class-icon"
        >
          📝
        </div>
        <h2 id="assignments-heading">ASSIGNMENTS.LOG</h2>
      </div>
      <p class="assignments-intro">
        Click an assignment to see how it could change the class grade.
      </p>

      {
        !hasAssignments ? (
          <div class="assignments-empty">
            <div>
              No assignment data available for this class yet.
            </div>
            <div class="assignments-empty-note">
              Run the scraper to collect assignment details.
            </div>
          </div>
        ) : (
          <div class="assignments-scroll">
            <table class="assignments-table">
              <thead>
                <tr class="border-b-[3px] border-b-[#555]">
                  <th>
                    Assignment
                  </th>
                  <th>
                    Due Date
                  </th>
                  <th class="align-right">
                    Score
                  </th>
                  <th class="align-right">
                    Percentage
                  </th>
                  <th class="align-center">
                    Status
                  </th>
                </tr>
              </thead>
              <tbody>
                {assignments.map((assignment) => {
                  return (
                  <tr class="assignments-row" data-assignment-id={assignment.id}>
                    <td class="assignments-cell" data-label="Assignment">
                      <button
                        type="button"
                        class="assignment-impact-button"
                        data-assignment-id={assignment.id}
                        aria-label={`View grade impact for ${assignment.name}`}
                      >
                        {assignment.name}
                      </button>
                    </td>
                    <td class="assignments-cell" data-label="Due Date">
                      {assignment.dueDate}
                    </td>
                    <td
                      class={`assignments-cell align-right ${assignment.status === "missing" ? "is-missing" : ""}`} data-label="Score"
                    >
                      {getScoreDisplay(assignment)}
                    </td>
                    <td class="assignments-cell align-right" data-label="Percentage">
                      {assignment.percentage !== null ? (
                        <span
                          class={`grade-badge ${getGradeColor(Math.round(assignment.percentage))}`}
                        >
                          {getPercentageDisplay(assignment)}
                        </span>
                      ) : (
                        <span class="assignment-unavailable">
                          {getPercentageDisplay(assignment)}
                        </span>
                      )}
                    </td>
                    <td class="assignments-cell align-center" data-label="Status">
                      {assignment.status === "missing" ? (
                        <span class="assignment-status is-missing">
                          MISSING
                        </span>
                      ) : assignment.status === "not-graded" ? (
                        <span class="assignment-status is-not-graded">
                          NOT GRADED
                        </span>
                      ) : assignment.status === "pending" ? (
                        <span class="assignment-status is-pending">
                          PENDING
                        </span>
                      ) : (
                        <span class="assignment-status is-graded">
                          GRADED
                        </span>
                      )}
                    </td>
                  </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>

  <div
    id="assignment-impact-modal"
    class="assignment-impact-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="assignment-impact-title"
    aria-describedby="assignment-impact-desc"
  >
    <div class="assignment-impact-dialog">
      <div class="assignment-impact-header">
        <div>
          <div id="assignment-impact-title" class="class-kicker">
            ASSIGNMENT IMPACT
          </div>
          <div id="assignment-impact-name" class="assignment-impact-name"></div>
        </div>
        <button
          id="assignment-impact-close"
          type="button"
          class="modal-close"
        >
          Close
        </button>
      </div>
      <div id="assignment-impact-desc" class="assignment-impact-content">
        <div class="impact-grid">
          <div class="impact-stat">
            <div>Due Date</div>
            <div id="assignment-impact-due"></div>
          </div>
          <div class="impact-stat">
            <div>Current Score</div>
            <div id="assignment-impact-score"></div>
          </div>
          <div class="impact-stat">
            <div>Worth</div>
            <div id="assignment-impact-worth"></div>
          </div>
          <div class="impact-stat">
            <div>Status</div>
            <div id="assignment-impact-status"></div>
          </div>
        </div>
        <div class="impact-grid impact-grid-three">
          <div class="impact-stat">
            <div>Current Grade</div>
            <div id="assignment-impact-current"></div>
          </div>
          <div class="impact-stat is-projected">
            <div>If 100%</div>
            <div id="assignment-impact-projected"></div>
          </div>
          <div class="impact-stat">
            <div>Change</div>
            <div id="assignment-impact-delta"></div>
          </div>
        </div>
        <div class="impact-note">
          Projection assumes full points on this assignment.
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ assignmentsData: JSON.stringify(assignments) }} data-astro-rerun>
    function initAssignmentImpact() {
      const assignments = JSON.parse(assignmentsData);
      const modal = document.getElementById('assignment-impact-modal');
      const closeButton = document.getElementById('assignment-impact-close');
      const nameEl = document.getElementById('assignment-impact-name');
      const dueEl = document.getElementById('assignment-impact-due');
      const scoreEl = document.getElementById('assignment-impact-score');
      const worthEl = document.getElementById('assignment-impact-worth');
      const statusEl = document.getElementById('assignment-impact-status');
      const currentEl = document.getElementById('assignment-impact-current');
      const projectedEl = document.getElementById('assignment-impact-projected');
      const deltaEl = document.getElementById('assignment-impact-delta');
      const buttons = document.querySelectorAll('.assignment-impact-button');

      if (!modal || !closeButton) {
        return;
      }

      let lastFocused = null;

      function computeTotals(list) {
        return list.reduce(
          (totals, assignment) => {
            if (assignment.maxPoints <= 0) {
              return totals;
            }
            const earned = assignment.score === null ? 0 : assignment.score;
            totals.earned += earned;
            totals.possible += assignment.maxPoints;
            return totals;
          },
          { earned: 0, possible: 0 }
        );
      }

      function formatGrade(value) {
        if (value === null || Number.isNaN(value)) {
          return 'N/A';
        }
        return `${value.toFixed(1)}%`;
      }

      function calculateGrade(earned, possible) {
        if (!possible) {
          return null;
        }
        return Math.round((earned / possible) * 1000) / 10;
      }

      function openModal(assignment) {
        const totals = computeTotals(assignments);
        const currentGrade = calculateGrade(totals.earned, totals.possible);
        const currentScore = assignment.score === null ? 0 : assignment.score;
        const projectedEarned = totals.earned - currentScore + assignment.maxPoints;
        const projectedGrade =
          assignment.maxPoints > 0 ? calculateGrade(projectedEarned, totals.possible) : null;
        const delta = projectedGrade === null || currentGrade === null ? null : projectedGrade - currentGrade;

        nameEl.textContent = assignment.name;
        dueEl.textContent = assignment.dueDate;
        scoreEl.textContent =
          assignment.score === null ? 'PENDING' : `${assignment.score}/${assignment.maxPoints}`;
        worthEl.textContent = `${assignment.maxPoints} pts`;
        statusEl.textContent = assignment.status.toUpperCase();
        currentEl.textContent = formatGrade(currentGrade);
        projectedEl.textContent = formatGrade(projectedGrade);
        deltaEl.textContent = delta === null ? 'N/A' : `${delta >= 0 ? '+' : ''}${delta.toFixed(1)}%`;
        deltaEl.style.color =
          delta === null ? 'rgba(199, 218, 204, .48)' : delta > 0.5 ? '#9fbea8' : delta < -0.5 ? '#c7aa72' : 'rgba(199, 218, 204, .48)';

        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        lastFocused = document.activeElement;
        closeButton.focus();
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        if (lastFocused instanceof HTMLElement) {
          lastFocused.focus();
        }
      }

      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal.classList.contains('is-open')) {
          closeModal();
        }
      });

      buttons.forEach((button) => {
        if (button.dataset.listenerAttached === 'true') {
          return;
        }
        button.dataset.listenerAttached = 'true';
        button.addEventListener('click', () => {
          const assignmentId = button.dataset.assignmentId;
          const assignment = assignments.find((item) => item.id === assignmentId);
          if (!assignment) {
            return;
          }
          openModal(assignment);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAssignmentImpact);
    } else {
      setTimeout(initAssignmentImpact, 50);
    }
  </script>

  <style>
    .class-page { width: min(100%, 52rem); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) 0 3rem; color: #e8eee9; font-family: "DM Sans", sans-serif; }
    .class-back-wrap { margin-bottom: 1.25rem; }
    .class-back-link { display: inline-flex; align-items: center; gap: .45rem; border: 1px solid rgba(159, 190, 168, .4); border-radius: 999px; padding: .65rem .85rem; color: #9fbea8; background: rgba(12, 23, 18, .55); font: 500 .58rem/1 "DM Sans", sans-serif; letter-spacing: .08em; text-decoration: none; }
    .class-back-link:hover, .class-back-link:focus-visible { color: #142219; background: #9fbea8; outline: none; }
    .class-header-card, .assignments-panel { border: 1px solid rgba(174, 202, 184, .18); border-radius: 1rem; background: rgba(12, 23, 18, .62); box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, .18); }
    .class-header-card { padding: clamp(1rem, 4vw, 1.5rem); }
    .class-header-top, .assignments-heading { display: flex; align-items: center; gap: .85rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(174, 202, 184, .14); }
    .class-icon { display: grid; flex: 0 0 auto; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid rgba(199, 170, 114, .46); border-radius: .75rem; background: rgba(199, 170, 114, .08); font-size: 1.15rem; }
    .class-kicker { margin: 0 0 .35rem; color: #c7aa72; font: 500 .56rem/1.3 "DM Sans", sans-serif; letter-spacing: .12em; text-transform: uppercase; }
    .class-header-top h1 { margin: 0; overflow-wrap: anywhere; color: #e8eee9; font: 600 clamp(1.15rem, 5vw, 1.7rem)/1.15 "DM Sans", sans-serif; letter-spacing: .02em; }
    .class-overview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-top: 1rem; }
    .class-info-card { min-width: 0; border: 1px solid rgba(174, 202, 184, .12); border-radius: .7rem; padding: .85rem; background: rgba(24, 40, 30, .34); }
    .class-info-card > span { display: block; margin-bottom: .45rem; color: rgba(199, 218, 204, .52); font: 500 .5rem/1.2 "DM Sans", sans-serif; letter-spacing: .09em; }
    .class-info-card strong { display: block; overflow-wrap: anywhere; color: #e8eee9; font: 500 .75rem/1.3 "DM Sans", sans-serif; }
    .class-grade-values { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; }
    .class-page .grade-badge { border: 0; border-radius: 999px; padding: .45rem .6rem; font: 600 .62rem/1 "DM Sans", sans-serif; }
    .class-page .grade-badge.grade-a { color: #142219; background: #9fbea8; }
    .class-page .grade-badge.grade-b { color: #242016; background: #c7aa72; }
    .class-page .grade-badge.grade-c { color: #242016; background: #b8a47a; }
    .class-page .grade-badge.grade-d, .class-page .grade-badge.grade-f { color: #e8eee9; background: #6c756d; }
    .assignments-panel { margin-top: 1rem; padding: clamp(1rem, 4vw, 1.5rem); }
    .assignments-heading { justify-content: flex-start; }
    .assignments-heading h2 { margin: 0; color: #e8eee9; font: 600 clamp(1rem, 4vw, 1.3rem)/1.15 "DM Sans", sans-serif; letter-spacing: .06em; }
    .assignments-intro { margin: .9rem 0 1rem; color: rgba(199, 218, 204, .62); font: 400 .68rem/1.45 "DM Sans", sans-serif; }
    .assignments-scroll { overflow-x: auto; }
    .assignments-table { width: 100%; border-collapse: collapse; }
    .assignments-table th { padding: .7rem .55rem; border-bottom: 1px solid rgba(174, 202, 184, .2); color: #9fbea8; font: 500 .48rem/1.2 "DM Sans", sans-serif; letter-spacing: .09em; text-align: left; text-transform: uppercase; }
    .assignments-table td { padding: .75rem .55rem; border-bottom: 1px solid rgba(174, 202, 184, .1); color: rgba(232, 238, 233, .78); font: 400 .62rem/1.35 "DM Sans", sans-serif; vertical-align: middle; }
    .assignments-row:hover { background: rgba(159, 190, 168, .05); }
    .assignments-cell:first-child { min-width: 12rem; }
    .align-right { text-align: right !important; }
    .align-center { text-align: center !important; }
    .assignment-impact-button { max-width: 100%; padding: 0; border: 0; color: #b9d2bf; background: transparent; font: inherit; text-align: left; text-decoration: underline; text-decoration-color: rgba(159, 190, 168, .55); text-underline-offset: .18rem; cursor: pointer; }
    .assignment-impact-button:hover, .assignment-impact-button:focus-visible { color: #e8eee9; text-decoration-color: #c7aa72; outline: none; }
    .assignments-cell.is-missing { color: #c7aa72; }
    .assignment-unavailable { color: rgba(199, 218, 204, .45); }
    .assignment-status { display: inline-block; border-radius: 999px; padding: .3rem .45rem; font: 500 .46rem/1 "DM Sans", sans-serif; letter-spacing: .06em; white-space: nowrap; }
    .assignment-status.is-missing { color: #c7aa72; background: rgba(199, 170, 114, .12); }
    .assignment-status.is-not-graded, .assignment-status.is-pending { color: #9fbea8; background: rgba(159, 190, 168, .1); }
    .assignment-status.is-graded { color: #b9d2bf; background: rgba(159, 190, 168, .14); }
    .assignments-empty { padding: 2.5rem 1rem; color: rgba(199, 218, 204, .62); font-size: .68rem; text-align: center; text-transform: uppercase; }
    .assignments-empty-note { margin-top: .5rem; color: rgba(199, 218, 204, .4); font-size: .58rem; }
    .assignment-impact-modal { position: fixed; inset: 0; z-index: 50; display: none; align-items: center; justify-content: center; padding: 1rem; background: rgba(2, 7, 5, .82); }
    .assignment-impact-modal.is-open { display: flex; }
    .assignment-impact-dialog { width: min(100%, 36rem); max-height: 90svh; overflow-y: auto; border: 1px solid rgba(174, 202, 184, .22); border-radius: 1rem; padding: clamp(1rem, 4vw, 1.5rem); background: #101d16; box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .35); }
