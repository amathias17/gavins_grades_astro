---
import BaseLayout from "../layouts/BaseLayout.astro";
import gradesData from "../data/grades.json";
import detailedGrades from "../../scraper/detailed-grades.json";
import { getClassRouteKey, normalizeClassName } from "../utils/classRoutes";

const scrapedClasses = detailedGrades.classes ?? [];
const activeClassKeys = new Set(
  scrapedClasses.map((classInfo) => `${normalizeClassName(classInfo.className)}|${classInfo.period.trim()}`),
);
const classes = (gradesData.classes ?? []).filter((classInfo) =>
  activeClassKeys.has(`${normalizeClassName(classInfo.class_name)}|${classInfo.period.trim()}`),
);
const lastUpdated = gradesData.metadata?.last_updated ?? "Unavailable";

function getGradeTone(grade: number): string {
  if (grade >= 90) return "grade-a";
  if (grade >= 80) return "grade-b";
  if (grade >= 70) return "grade-c";
  if (grade >= 60) return "grade-d";
  return "grade-f";
}

function formatGrade(grade: number | null | undefined): string {
  return typeof grade === "number" && Number.isFinite(grade) ? `${grade}%` : "--";
}

function formatLetterGrade(letter: string | null | undefined): string {
  return typeof letter === "string" && letter.trim() ? letter : "--";
}
---

<BaseLayout>
  <div class="grade-room">
    <a class="back-link" href="/" aria-label="Back to the grades overview">← BACK TO OVERVIEW</a>

    <header class="grade-room-header">
      <div>
        <p class="eyebrow">GAVIN'S CURRENT GRADES</p>
        <h1 id="grade-room-title">GRADE ROOM</h1>
        <p class="intro">Current marks, organized by class.</p>
      </div>
      <div class="freshness" aria-label={`Grade data updated ${lastUpdated}`}>
        <span>LAST UPDATED</span>
        <time>{lastUpdated}</time>
      </div>
    </header>

    <section aria-labelledby="current-grades-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">YOUR SCHEDULE</p>
          <h2 id="current-grades-heading">Active classes</h2>
        </div>
        <p class="class-count"><strong>{classes.length}</strong> {classes.length === 1 ? "class" : "classes"}</p>
      </div>

      <div class="grade-list" aria-label="Current grades by class">
        <div class="list-heading" aria-hidden="true">
          <span>PERIOD</span>
          <span>CLASS</span>
          <span>MARK</span>
          <span></span>
        </div>
        {classes.map((classInfo) => {
          const grade = typeof classInfo.current_grade === "number" && Number.isFinite(classInfo.current_grade)
            ? classInfo.current_grade
            : null;
          const tone = grade === null ? "grade-ungraded" : getGradeTone(grade);
          const routeKey = getClassRouteKey(classInfo, gradesData.classes ?? []);
          return (
            <a
              class={`grade-row ${tone}`}
              href={`/classes/${routeKey}`}
              data-grade-card
              aria-label={`Open ${classInfo.class_name}, period ${classInfo.period}, current grade ${formatGrade(grade)} ${formatLetterGrade(classInfo.letter_grade)}`}
            >
              <span class="period">P{classInfo.period}</span>
              <span class="class-details">
                <span class="class-name">{classInfo.class_name}</span>
                <span class="teacher">{classInfo.teacher}</span>
              </span>
              <span class="grade-readout">
                <span class="percentage">{formatGrade(grade)}</span>
                <span class="letter" aria-label={`Letter grade ${formatLetterGrade(classInfo.letter_grade)}`}>{formatLetterGrade(classInfo.letter_grade)}</span>
              </span>
              <span class="row-link" aria-hidden="true">↗</span>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <style>
    .grade-room { width: min(100%, 960px); margin: 0 auto; padding: 2.5rem 0 4rem; }
    .back-link { display: inline-flex; min-height: 2.75rem; align-items: center; margin-bottom: 1.6rem; color: var(--ledger-muted); font: 700 .68rem/1 "DM Mono", monospace; letter-spacing: .07em; text-decoration: none; }
    .back-link:hover, .back-link:focus-visible { color: var(--ledger-green); }
    .grade-room-header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; border-bottom: 1px solid rgba(174, 202, 184, .22); padding: .35rem 0 2rem; }
    .eyebrow { margin: 0 0 .75rem; color: var(--ledger-green); font: 700 .68rem/1.2 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
    h1, h2 { margin: 0; color: var(--ledger-ink); font-family: "Orbitron", sans-serif; letter-spacing: .05em; }
    h1 { font-size: clamp(2rem, 5vw, 3rem); }
    h2 { font-size: clamp(1.15rem, 2.5vw, 1.55rem); letter-spacing: .025em; }
    .intro { margin: .7rem 0 0; color: var(--ledger-muted); font: 400 1rem/1.5 "DM Sans", sans-serif; }
    .freshness { flex: 0 0 auto; display: grid; gap: .45rem; padding-left: 1.25rem; border-left: 1px solid rgba(174, 202, 184, .22); }
    .freshness span { color: var(--ledger-muted); font: 700 .68rem/1.2 "DM Mono", monospace; letter-spacing: .08em; }
    .freshness time { color: var(--ledger-ink); font: 500 .82rem/1.4 "DM Mono", monospace; }
    section { margin-top: 2.2rem; }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
    .class-count { margin: 0 0 .1rem; color: var(--ledger-muted); font: 500 .9rem/1.4 "DM Sans", sans-serif; white-space: nowrap; }
    .class-count strong { margin-right: .2rem; color: var(--ledger-green); font: 700 1.25rem/1 "Orbitron", sans-serif; }
    .list-heading, .grade-row { display: grid; grid-template-columns: 5rem minmax(0, 1fr) 9rem 2rem; align-items: center; column-gap: 1rem; }
    .list-heading { padding: 0 .9rem .65rem; color: var(--ledger-muted); font: 700 .68rem/1.3 "DM Mono", monospace; letter-spacing: .08em; }
    .list-heading span:nth-child(3) { text-align: right; }
    .grade-row { min-height: 5.6rem; padding: .8rem .9rem; border-top: 1px solid rgba(174, 202, 184, .17); color: var(--ledger-ink); text-decoration: none; transition: background-color .16s ease, border-color .16s ease; }
    .grade-row:last-child { border-bottom: 1px solid rgba(174, 202, 184, .17); }
    .grade-row:hover { border-color: rgba(159, 190, 168, .4); background: rgba(159, 190, 168, .055); }
    .grade-row:focus-visible { position: relative; z-index: 1; outline: 3px solid var(--ledger-green); outline-offset: 2px; }
    .period { color: var(--ledger-green); font: 700 .78rem/1 "DM Mono", monospace; }
    .class-details { display: grid; gap: .28rem; min-width: 0; }
    .class-name { overflow-wrap: anywhere; color: var(--ledger-ink); font: 600 1rem/1.35 "DM Sans", sans-serif; }
    .teacher { overflow-wrap: anywhere; color: var(--ledger-muted); font: 400 .82rem/1.35 "DM Sans", sans-serif; }
    .grade-readout { display: flex; align-items: baseline; justify-content: flex-end; gap: .7rem; }
    .percentage { color: var(--grade-color); font: 700 clamp(1.45rem, 3.2vw, 1.85rem)/1 "Orbitron", sans-serif; }
    .letter { min-width: 1.25rem; color: var(--grade-color); font: 700 .94rem/1 "Orbitron", sans-serif; text-align: center; }
    .row-link { color: var(--ledger-muted); font: 500 1rem/1 "DM Mono", monospace; text-align: right; transition: color .16s ease, transform .16s ease; }
    .grade-row:hover .row-link { color: var(--ledger-green); transform: translate(2px, -2px); }
    .grade-a { --grade-color: #9fbea8; }
    .grade-b { --grade-color: #c7aa72; }
    .grade-c { --grade-color: #d4a373; }
    .grade-d { --grade-color: #e59b8c; }
    .grade-f { --grade-color: #e06c75; }
    .grade-ungraded { --grade-color: var(--ledger-muted); }
    @media (max-width: 700px) {
      .grade-room { width: min(100% - 2rem, 560px); padding-top: 1.6rem; }
      .grade-room-header { align-items: start; flex-direction: column; gap: 1.25rem; padding-bottom: 1.5rem; }
      .freshness { padding-left: 0; border-left: 0; }
      .section-heading { margin-bottom: 1rem; }
      .list-heading, .grade-row { grid-template-columns: 2.7rem minmax(0, 1fr) auto 1rem; column-gap: .65rem; }
      .list-heading { padding-inline: .45rem; font-size: .62rem; }
      .grade-row { min-height: 5.2rem; padding: .75rem .45rem; }
      .percentage { font-size: clamp(1.2rem, 5vw, 1.55rem); }
      .grade-readout { gap: .35rem; }
    }
    @media (max-width: 380px) {
      .grade-room { width: min(100% - 1.5rem, 560px); }
      .list-heading, .grade-row { grid-template-columns: 2.35rem minmax(0, 1fr) auto .8rem; column-gap: .45rem; }
      .class-name { font-size: .94rem; }
      .teacher { font-size: .78rem; }
      .percentage { font-size: 1.18rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .grade-row, .row-link { transition: none; }
    }
  </style>
</BaseLayout>
